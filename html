<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>INTERNOVA</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <nav>
        <h2><span>✦</span>INTERNOVA</h2>
        <div>
            <a href="#home">Home</a>
            <a href="">Careers</a>
            <a href="">Events</a>
            <a href="">Notifications</a>
        </div>
        <main class="main-area">
            <header class="topbar">
                <div class="top-actions">
                    <label class="role-switch"><span>View as</span>
                        <select id="roleSelect" aria-label="Choose demo role">
                            <option value="student">Student</option>
                            <option value="staff">Faculty / Placement</option>
                            <option value="admin">Admin</option>
                        </select>
                    </label>
                    <div class="avatar" title="Demo account">D</div>
                </div>
            </header>
    </nav>
    <section class="home">
        <p class="tag"><span>✦</span> YOUR NEXT STEP STARTS HERE </p>
        <h2>Find opportunities.<span><br>Build your future.<br></span></h2>
        <p class="description">Discover internship, jobs, courses and certification shared by your<br>college
            community.</br></p>
        <a href="" class="button"> Explore Opportunities → </a>
    </section>

    <section class="stat-grid" aria-label="opportunity statistics">
        <div class="stat-card">
            <div class="stat-icon purple">▣</div>
            <div><span>Opportunities</span><strong id="statTotal">0</strong></div>
            <small class="stat-note">Available to explore</small>
        </div>
        <div class="stat-card">
            <div class="stat-icon mint">◉</div>
            <div><span>Internships</span><strong id="statInternships">0</strong></div>
            <small class="stat-note">Gain real experience</small>
        </div>
        <div class="stat-card">
            <div class="stat-icon peach">⌘</div>
            <div><span>Courses</span><strong id="statCourses">0</strong></div>
            <small class="stat-note">Build your skills</small>
        </div>
        <div class="stat-card">
            <div class="stat-icon blue">✓</div>
            <div><span>Reviewed posts</span><strong id="statVerified">0</strong></div>
            <small class="stat-note">Checked by moderators</small>
        </div>
    </section>
    <section class="tool">
        <div class="eyebrow">EXPLORE & GROW</div>
        <div class="section-heading">
            <h2>Opportunity for you</h2>
            <a href="#" class="button"> Share an Opportunities + </a>
        </div>
        <p class="list">Find your next learning or career milestone.</p>
    </section>
    <div class="search">
        <div class="search-box" <span>🔎</span><input id="searchInput" type="search"
                placeholder="Search roles, skills, companies...."></div>
        <select id="catergories">
            <option value="All categories"></option>
            <option>Internship</option>
            <option>Jobs</option>
            <option>Webinor</option>
            <option>Hackatons</option>
        </select>
        <select id="modes">
            <option value="All modes"></option>
            <option>Online</option>
            <option>Offline</option>
            <option>Hybrid</option>
        </select>
        <select id="levels">
            <option value="All Levels"></option>
            <option>Easy</option>
            <option>intermediate</option>
            <option>Hard</option>
        </select>

    </div>



</body>

</html>